<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink != '/' %}
        <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% include social.liquid %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              {{- about_title }}
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" title="Search" onclick="openSearchModal()">
                <span class="nav-link">ctrl k <i class="ti ti-search"></i></span>
              </button>
            </li>
          {% endif %}
          {% comment %}
            Prepare the current URL so language toggle links can swap inner collection folders
            like /projects/en/* when localized versions exist.
          {% endcomment %}
          {% assign normalized_url = page.url %}
          {% if site.active_lang != site.default_lang %}
            {% assign active_prefix = '/' | append: site.active_lang | append: '/' %}
            {% assign prefix_length = active_prefix | size %}
            {% assign current_prefix = normalized_url | slice: 0, prefix_length %}
            {% if current_prefix == active_prefix %}
              {% assign normalized_url = normalized_url | replace_first: active_prefix, '/' %}
            {% elsif normalized_url == '/' | append: site.active_lang %}
              {% assign normalized_url = '/' %}
            {% endif %}
          {% endif %}
          {% assign source_lang = '' %}
          {% assign path_parts = page.path | split: '/' %}
          {% if path_parts.size > 1 %}
            {% assign possible_lang = path_parts[1] %}
            {% if site.languages contains possible_lang %}
              {% assign source_lang = possible_lang %}
            {% endif %}
          {% endif %}
          {% assign inner_lang_segment = '' %}
          {% if source_lang != '' %}
            {% assign candidate_segment = '/' | append: source_lang | append: '/' %}
            {% if normalized_url contains candidate_segment %}
              {% assign inner_lang_segment = candidate_segment %}
            {% endif %}
          {% endif %}
          {% assign source_segment = '' %}
          {% if source_lang != '' %}
            {% assign source_segment = '/' | append: source_lang | append: '/' %}
          {% endif %}
          {% assign can_swap_inner_lang = false %}
          {% if inner_lang_segment != '' and source_segment != '' %}
            {% assign can_swap_inner_lang = true %}
          {% endif %}
          <!-- Toogle language -->
          {% if site.languages.size >= 2 %}
            {% if site.languages.size == 2 %}
              {% if site.active_lang == site.languages.first %}
                {% assign other_language = site.languages.last %}
              {% else %}
                {% assign other_language = site.languages.first %}
              {% endif %}
              <li class="nav-item active">
                {% assign target_lang = other_language %}
                {% assign resolved_url = normalized_url %}
                {% if can_swap_inner_lang %}
                  {% assign target_segment = '/' | append: target_lang | append: '/' %}
                  {% capture candidate_path %}{{ page.path | replace_first: source_segment, target_segment }}{% endcapture %}
                  {% assign candidate_path = candidate_path | strip %}
                  {% capture translation_exists %}{% file_exists {{ candidate_path }} %}{% endcapture %}
                  {% if translation_exists | strip == 'true' %}
                    {% assign resolved_url = normalized_url | replace_first: inner_lang_segment, target_segment %}
                  {% endif %}
                {% endif %}
                {% if target_lang == site.default_lang %}
                  {% assign switch_url = resolved_url %}
                {% else %}
                  {% assign switch_url = '/' | append: target_lang | append: resolved_url %}
                {% endif %}
                {% if site.active_lang == site.default_lang %}
                  <a class="nav-link" {% static_href -%} href="{{ site.baseurl }}{{ switch_url }}" {%- endstatic_href %}>
                    {% if site.country_flag %}
                      <span class="fi fi-{{ other_language | split: "-" | last }}"></span>
                    {% else %}
                      {{ other_language | upcase }}
                    {%- endif -%}
                  </a>
                {% else %}
                  {% assign target_lang = site.default_lang %}
                  {% assign resolved_url = normalized_url %}
                  {% if can_swap_inner_lang %}
                    {% assign target_segment = '/' | append: target_lang | append: '/' %}
                    {% capture candidate_path %}{{ page.path | replace_first: source_segment, target_segment }}{% endcapture %}
                    {% assign candidate_path = candidate_path | strip %}
                    {% capture translation_exists %}{% file_exists {{ candidate_path }} %}{% endcapture %}
                    {% if translation_exists | strip == 'true' %}
                      {% assign resolved_url = normalized_url | replace_first: inner_lang_segment, target_segment %}
                    {% endif %}
                  {% endif %}
                  {% assign switch_url = resolved_url %}
                  <a class="nav-link" {% static_href -%} href="{{ site.baseurl }}{{ switch_url }}" {%- endstatic_href %}>
                    {% if site.country_flag %}
                      <span class="fi fi-{{ site.default_lang | split: "-" | last }}"></span>
                    {% else %}
                      {{ site.default_lang | upcase }}
                    {%- endif -%}
                  </a>
                {% endif %}
              </li>
            {% else %}
              <li class="nav-item dropdown {% if page.title == p.title %}active{% endif %}">
                <a
                  class="nav-link dropdown-toggle"
                  href="#"
                  id="navbarDropdown"
                  role="button"
                  data-toggle="dropdown"
                  aria-haspopup="true"
                  aria-expanded="false"
                >
                  {% if site.country_flag %}
                    <span class="fi fi-{{ site.active_lang | split: "-" | last }}"></span>
                  {% else %}
                    {{- site.active_lang | upcase }}
                  {%- endif -%}
                  {% if page.title == p.title %}
                    <span class="sr-only">(current)</span>
                  {% endif %}
                </a>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                  {% assign language_set = false %}
                  {% for l in site.languages %}
                    {% if l != site.active_lang %}
                      {% if language_set %}
                        <div class="dropdown-divider"></div>
                      {% endif %}
                      {% assign target_lang = l %}
                      {% assign resolved_url = normalized_url %}
                      {% if can_swap_inner_lang %}
                        {% assign target_segment = '/' | append: target_lang | append: '/' %}
                        {% capture candidate_path %}{{ page.path | replace_first: source_segment, target_segment }}{% endcapture %}
                        {% assign candidate_path = candidate_path | strip %}
                        {% capture translation_exists %}{% file_exists {{ candidate_path }} %}{% endcapture %}
                        {% if translation_exists | strip == 'true' %}
                          {% assign resolved_url = normalized_url | replace_first: inner_lang_segment, target_segment %}
                        {% endif %}
                      {% endif %}
                      {% if target_lang == site.default_lang %}
                        {% assign switch_url = resolved_url %}
                      {% else %}
                        {% assign switch_url = '/' | append: target_lang | append: resolved_url %}
                      {% endif %}
                      <a class="dropdown-item" {% static_href -%} href="{{ site.baseurl }}{{ switch_url }}" {%- endstatic_href %}>
                        {% if site.country_flag %}
                          <span class="fi fi-{{ l | split: "-" | last }}"></span>
                        {% else %}
                          {{ l | upcase }}
                        {%- endif -%}
                      </a>
                      {% assign language_set = true %}
                    {% endif %}
                  {% endfor %}
                </div>
              </li>
            {% endif %}
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="Change theme">
                <i class="ti ti-sun-moon" id="light-toggle-system"></i>
                <i class="ti ti-moon-filled" id="light-toggle-dark"></i>
                <i class="ti ti-sun-filled" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
